{"n":5,"scene":"Từ ghi chú cuối ca, bạn cần viết một câu để người đọc hình dung chính xác cụ đã ở đâu, ai phát hiện và lúc đó cụ nói gì.","goals":["Ghi lại diễn biến theo mốc thời gian.","Dẫn lời và phân biệt sự thật với suy đoán."],"people":[],"know":["Một bản ghi có thể gồm thời điểm, nơi phát hiện, diễn biến, người nhận thông báo và việc tiếp theo. Viết lời cụ trong ngoặc 「 」 khi trích trực tiếp. Nếu chỉ biết lúc phát hiện, hãy ghi đó là lúc phát hiện."],"terms":[{"w":"記録","r":"きろく","ro":"kiroku","vi":"ghi chép","pos":"danh từ"},{"w":"事実","r":"じじつ","ro":"jijitsu","vi":"sự thật","pos":"danh từ"},{"w":"推測","r":"すいそく","ro":"suisoku","vi":"suy đoán","pos":"danh từ"},{"w":"主観","r":"しゅかん","ro":"shukan","vi":"chủ quan","pos":"danh từ"},{"w":"客観","r":"きゃっかん","ro":"kyakkan","vi":"khách quan","pos":"danh từ"},{"w":"経過","r":"けいか","ro":"keika","vi":"diễn biến","pos":"danh từ"}],"grammar":[{"no":1,"p":"〜時に","ro":"… ji ni","vi":"Vào lúc…","form":"Giờ + に + sự việc","use":"Dùng mốc giờ để người đọc dựng lại trình tự.","ex":[{"jp":"三時に訪室しました。","ro":"sanji ni houshitsushimashita.","vi":"Tôi vào phòng lúc ba giờ.","words":[{"w":"三時","r":"さんじ","ro":"sanji","vi":"ba giờ","pos":"danh từ"},{"w":"に","ro":"ni","vi":"ở, vào, cho (chỉ vị trí, thời điểm hoặc đối tượng)","pos":"trợ từ"},{"w":"訪室しました","r":"ほうしつしました","ro":"houshitsushimashita","vi":"đã vào thăm phòng","pos":"động từ"},{"w":"。"}]},{"jp":"四時に報告しました。","ro":"yoji ni houkokushimashita.","vi":"Tôi báo cáo lúc bốn giờ.","words":[{"w":"四時","r":"よじ","ro":"yoji","vi":"bốn giờ","pos":"danh từ"},{"w":"に","ro":"ni","vi":"ở, vào, cho (chỉ vị trí, thời điểm hoặc đối tượng)","pos":"trợ từ"},{"w":"報告しました","r":"ほうこくしました","ro":"houkokushimashita","vi":"đã báo cáo","pos":"động từ"},{"w":"。"}]}]},{"no":2,"p":"〜とのことです","ro":"… to no koto desu","vi":"Theo lời kể thì…","form":"Nội dung nghe được + とのことです","use":"Cho người đọc biết đây là thông tin được thuật lại.","ex":[{"jp":"眠れなかったとのことです。","ro":"nemurenakatta tonokotodesu.","vi":"Theo lời cụ kể, c