{"n":1,"scene":"Một nhân viên thấy lối ra nhà vệ sinh bị chắn. Trong buổi giao ca, cả nhóm cần gọi tên nguy cơ và thống nhất điều sẽ kiểm tra lại.","goals":["Phân biệt ヒヤリハット, 事故 và 緊急 trong một tình huống cụ thể.","Nêu vị trí của nguy cơ và đề xuất một việc có thể kiểm tra lại."],"people":[],"know":["ヒヤリハット là một lần suýt xảy ra sự cố. Khi kể lại, hãy nêu điều mình thấy, việc đã làm và kết quả. Với chu trình PDCA, cả nhóm còn quay lại xem biện pháp đã thống nhất có tác dụng hay chưa."],"terms":[{"w":"ヒヤリハット","ro":"hiyarihatto","vi":"suýt xảy ra sự cố","pos":"danh từ"},{"w":"事故","r":"じこ","ro":"jiko","vi":"tai nạn","pos":"danh từ"},{"w":"緊急","r":"きんきゅう","ro":"kinkyuu","vi":"khẩn cấp","pos":"danh từ"},{"w":"予防","r":"よぼう","ro":"yobou","vi":"phòng ngừa","pos":"danh từ"},{"w":"対策","r":"たいさく","ro":"taisaku","vi":"biện pháp đối phó","pos":"danh từ"},{"w":"再発防止","r":"さいはつぼうし","ro":"saihatsuboushi","vi":"phòng ngừa tái diễn","pos":"danh từ"}],"grammar":[{"no":1,"p":"〜に…があります","ro":"… ni … ga arimasu","vi":"Ở đâu có gì","form":"Địa điểm + に + vật + があります","use":"Dùng に để người nghe tìm đúng vị trí.","ex":[{"jp":"廊下に荷物があります。","ro":"rouka ni nimotsu ga arimasu.","vi":"Ở hành lang có hành lý.","words":[{"w":"廊下","r":"ろうか","ro":"rouka","vi":"hành lang","pos":"danh từ"},{"w":"に","ro":"ni","vi":"ở, vào, cho (chỉ vị trí, thời điểm hoặc đối tượng)","pos":"trợ từ"},{"w":"荷物","r":"にもつ","ro":"nimotsu","vi":"hành lý, đồ đạc","pos":"danh từ"},{"w":"が","ro":"ga","vi":"đánh dấu chủ ngữ","pos":"trợ từ"},{"w":"あります","ro":"arimasu","vi":"có","pos":"động từ"},{"w":"。"}]},{"jp":"入口に段差があります。","ro":"iriguchi ni dansa ga arimasu.","vi":"Lối vào có một bậc chênh cao.","words":[{"w":"入口","r":"いりぐち","ro":"iriguchi","vi":"lối vào","pos":"danh từ"},{"w":"に","ro":"ni","vi":"ở, vào, cho (chỉ vị trí, thời điểm hoặc đối tượng)","pos":"trợ từ"},{"w":"段差","r":"だんさ","ro":"dansa","vi":"bậc chênh cao","pos":"danh từ"},{"w":"が","ro":"ga","vi":"đánh dấu chủ ngữ","pos":"trợ từ"},{"w":"あります","ro":"arimasu","vi":"c