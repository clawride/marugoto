{"n":11,"scene":"Khi một cụ từ chối bữa ăn hoặc gia đình muốn biếu quà riêng, nhân viên mới cần biết cách hỏi ý kiến trưởng ca. Hai người luyện phân biệt ý muốn của cụ và quy định của cơ sở.","goals":["Thuật lại ý của cụ qua lời nói trực tiếp.","Xin ý kiến đồng nghiệp khi gặp tình huống khó."],"people":[],"know":["Các câu hỏi trong chương còn đề cập đến báo cáo muộn và lời nói gây tổn thương. Một lời xin tư vấn dễ hiểu có ba ý: sự việc, phần khiến mình băn khoăn và câu hỏi cụ thể."],"terms":[{"w":"拒否","r":"きょひ","ro":"kyohi","vi":"từ chối","pos":"danh từ"},{"w":"贈り物","r":"おくりもの","ro":"okurimono","vi":"quà biếu","pos":"danh từ"},{"w":"規則","r":"きそく","ro":"kisoku","vi":"quy định","pos":"danh từ"},{"w":"意思","r":"いし","ro":"ishi","vi":"ý muốn","pos":"danh từ"},{"w":"暴言","r":"ぼうげん","ro":"bougen","vi":"lời xúc phạm","pos":"danh từ"},{"w":"相談相手","r":"そうだんあいて","ro":"soudan'aite","vi":"người để hỏi ý kiến","pos":"danh từ"}],"grammar":[{"no":1,"p":"〜と言われました","ro":"… to iwaremashita","vi":"Tôi được nói rằng…","form":"Lời được nghe + と + 言われました","use":"Dẫn lời khi hỏi ý kiến người phụ trách.","ex":[{"jp":"後で食べたいと言われました。","ro":"atode tabetai to iwaremashita.","vi":"Cụ nói với tôi rằng cụ muốn ăn sau.","words":[{"w":"後で","r":"あとで","ro":"atode","vi":"lát nữa","pos":"trạng từ"},{"w":"食べたい","r":"たべたい","ro":"tabetai","vi":"muốn ăn","pos":"động từ"},{"w":"と","ro":"to","vi":"đánh dấu lời trích dẫn","pos":"trợ từ"},{"w":"言われました","r":"いわれました","ro":"iwaremashita","vi":"được nói cho biết","pos":"động từ"},{"w":"。"}]},{"jp":"今はいらないと言われました。","ro":"ima wa iranai to iwaremashita.","vi":"Cụ nói với tôi rằng bây giờ cụ chưa cần.","words":[{"w":"今","r":"いま","ro":"ima","vi":"bây giờ","pos":"danh từ"},{"w":"は","ro":"wa","vi":"nêu chủ đề","pos":"trợ từ"},{"w":"いらない","ro":"iranai","vi":"không cần","pos":"động từ"},{"w":"と","ro":"to","vi":"đánh dấu lời trích dẫn","pos":"trợ từ"},{"w":"言われました","r":"いわれました","ro":"iwaremashita","vi":"được nói cho biết","pos":"động từ"},{"w":"。"}]}]},{"no":2,"p":"〜たらいいですか","