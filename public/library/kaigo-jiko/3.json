{"n":3,"scene":"Bạn vào phòng và thấy cụ ngồi dưới sàn. Bạn biết nơi phát hiện và tư thế của cụ, nhưng chưa biết sự việc xảy ra thế nào.","goals":["Nêu địa điểm phát hiện và lời cụ nói.","Cho biết đã liên lạc với ai."],"people":[],"know":["Chương này đề cập đến ngã, gãy xương, tróc da, dùng nhầm thuốc và bỏng. Khi luyện tiếng Nhật, tách lời người được chăm sóc nói, điều chính bạn nhìn thấy và phần nguyên nhân còn phải xác minh."],"terms":[{"w":"骨折","r":"こっせつ","ro":"kossetsu","vi":"gãy xương","pos":"danh từ"},{"w":"熱傷","r":"ねっしょう","ro":"nesshou","vi":"bỏng","pos":"danh từ"},{"w":"誤薬","r":"ごやく","ro":"goyaku","vi":"dùng nhầm thuốc","pos":"danh từ"},{"w":"表皮剥離","r":"ひょうひはくり","ro":"hyouhihakuri","vi":"tróc da","pos":"danh từ"},{"w":"発見","r":"はっけん","ro":"hakken","vi":"phát hiện","pos":"danh từ"},{"w":"発生場所","r":"はっせいばしょ","ro":"hasseibasho","vi":"nơi xảy ra sự việc","pos":"danh từ"}],"grammar":[{"no":1,"p":"〜で見つけました","ro":"… de mitsukemashita","vi":"Đã tìm thấy ở…","form":"Địa điểm + で + đối tượng + を見つけました","use":"で đánh dấu nơi người báo cáo phát hiện sự việc.","ex":[{"jp":"居室で田中さんを見つけました。","ro":"kyoshitsu de tanakasan o mitsukemashita.","vi":"Tôi đã tìm thấy cụ Tanaka trong phòng riêng.","words":[{"w":"居室","r":"きょしつ","ro":"kyoshitsu","vi":"phòng riêng","pos":"danh từ"},{"w":"で","ro":"de","vi":"ở, bằng","pos":"trợ từ"},{"w":"田中さん","r":"たなかさん","ro":"tanakasan","vi":"cụ Tanaka","pos":"danh từ"},{"w":"を","ro":"o","vi":"đánh dấu đối tượng của hành động","pos":"trợ từ"},{"w":"見つけました","r":"みつけました","ro":"mitsukemashita","vi":"đã tìm thấy","pos":"động từ"},{"w":"。"}]},{"jp":"床で眼鏡を見つけました。","ro":"yuka de megane o mitsukemashita.","vi":"Tôi tìm thấy kính trên sàn.","words":[{"w":"床","r":"ゆか","ro":"yuka","vi":"sàn nhà","pos":"danh từ"},{"w":"で","ro":"de","vi":"ở, bằng","pos":"trợ từ"},{"w":"眼鏡","r":"めがね","ro":"megane","vi":"kính mắt","pos":"danh từ"},{"w":"を","ro":"o","vi":"đánh dấu đối tượng của hành động","pos":"trợ từ"},{"w":"見つけました","r":"みつけました","ro":"mitsukemashita","vi":"đã tì