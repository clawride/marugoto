# Sao chép file này thành .env.local (chạy trên máy) và thêm cùng biến vào Vercel → Settings → Environment Variables.
# Thiếu key thì trang tự dùng nguồn dự phòng (Wikimedia / Openverse / nekos.best).

# https://developers.giphy.com/dashboard/  → Create an App → API → copy "API Key"
GIPHY_API_KEY=

# https://www.pexels.com/api/  → Your API Key
PEXELS_API_KEY=
